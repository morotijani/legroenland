# ==============================================================================
# Le Groenland Healthcare Solutions - Apache Configuration
# Clean URLs (removes .html extensions) & Security Headers
# ==============================================================================

Options -MultiViews
RewriteEngine On

# 1. Remove trailing slash from non-directories (e.g. /about/ -> /about)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/+$
RewriteRule ^ %1 [R=301,L]

# 2. Redirect index.html or /index to directory root /
RewriteCond %{THE_REQUEST} \s/+(?:index(?:\.html)?)[\s?] [NC]
RewriteRule ^(?:index(?:\.html)?)?$ ./ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)/index(?:\.html)?[\s?] [NC]
RewriteRule ^(?:index(?:\.html)?)?$ /%1/ [R=301,L]

# 3. Redirect any external request for .html files to extensionless clean URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Internally rewrite extensionless URLs to their .html or .php counterpart if it exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

